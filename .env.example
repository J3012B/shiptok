# Where your local git checkouts live (comma-separated). Agents work in a fresh worktree of the matching repo.
CODE_ROOTS=~/Code
# How many agents run at once
MAX_AGENTS=3
# Daily XP goal (actions per day)
DAILY_GOAL=10
# Notion: internal integration token + the roadmap's data source id (from its "collection://…" URL)
# NOTION_TOKEN=ntn_...
# NOTION_DATA_SOURCE=...
# Curator: model, how often it re-curates (only when something changed), and a line about you
# CURATOR_MODEL=sonnet
# CURATE_EVERY_MIN=120
# CURATOR_CONTEXT=Founder of ..., teammates ...
# Agent permissions: what agents may do without asking you. Anything else comes back to the feed as an "Allow?" card.
# AGENT_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep,Bash(git:*),Bash(gh:*),Bash(npm test:*),Bash(npm run:*)
# AGENT_MODEL=
